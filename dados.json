{
  "nodesData": [
    {
      "id": "leg_title",
      "label": "REGRAS E PAPÉIS\nÚnico Contato",
      "type": "header",
      "x": 50,
      "y": 50
    },
    {
      "id": "leg_sys",
      "label": "⚙️ AUTOMAÇÃO / SISTEMA\nResponsável por:\n• Controlar a sequência temporal\n• Disparar mensagens e templates",
      "type": "system",
      "x": 50,
      "y": 150
    },
    {
      "id": "leg_ia",
      "label": "🤖 IA CONVERSACIONAL\nResponsável EXCLUSIVAMENTE por:\n• Interpretar a mensagem do cliente\n• Conversar e tirar dúvidas da base\n• Conduzir a conversa",
      "type": "message",
      "x": 50,
      "y": 350
    },
    {
      "id": "leg_sum",
      "label": "📄 RESUMO DA TRATATIVA\nContexto gerado sempre que a IA sai de cena. Fornece ao humano as informações (motivo, intenção) para ele não começar do zero.",
      "type": "summary",
      "x": 50,
      "y": 580
    },
    {
      "id": "leg_hum",
      "label": "👤 ATENDENTE HUMANO\nResponsável por:\n• Negociações, descontos, fechamentos\n• Ações de sistema, CRM e pagamentos\n• Tudo que for operacional e clínico",
      "type": "action",
      "x": 50,
      "y": 820
    },
    {
      "id": "f1_head",
      "label": "FLUXO 1\nREATIVAÇÃO DE ORÇAMENTOS",
      "type": "header",
      "x": 500,
      "y": 50
    },
    {
      "id": "f1_start",
      "label": "ORÇAMENTO ENVIADO\nFórmula Manipulada",
      "type": "process",
      "x": 500,
      "y": 150
    },
    {
      "id": "f1_wait",
      "label": "AGUARDA INTERAÇÃO\nCliente respondeu?",
      "type": "condition",
      "x": 500,
      "y": 300
    },
    {
      "id": "f1_1h",
      "label": "AUTOMAÇÃO: FOLLOW-UP (Ex: 1 hora)\n\nOlá [Nome]!\nConseguiu ver o orçamento? Qualquer dúvida, estou aqui! 💚",
      "type": "system",
      "x": 500,
      "y": 480
    },
    {
      "id": "f1_resp_1h",
      "label": "Cliente respondeu?",
      "type": "condition",
      "x": 500,
      "y": 680
    },
    {
      "id": "f1_ia_1h",
      "label": "🤖 ENCAMINHA PARA IA\n(IA assume a conversa -> Ver bloco à direita)",
      "type": "message",
      "x": 900,
      "y": 680
    },
    {
      "id": "f1_4h",
      "label": "AUTOMAÇÃO: FOLLOW-UP (Ex: 4 horas)\n\n[Nome], ainda tem interesse? Estamos com tudo pronto por aqui! ✨",
      "type": "system",
      "x": 500,
      "y": 850
    },
    {
      "id": "f1_resp_4h",
      "label": "Cliente respondeu?",
      "type": "condition",
      "x": 500,
      "y": 1050
    },
    {
      "id": "f1_ia_4h",
      "label": "🤖 ENCAMINHA PARA IA\n(IA assume a conversa -> Ver bloco à direita)",
      "type": "message",
      "x": 900,
      "y": 1050
    },
    {
      "id": "f1_24h",
      "label": "AUTOMAÇÃO: PESQUISA (Ex: 24 horas)\n\nNotamos que não finalizou. Poderia nos dizer rapidamente o motivo?\n(Preço, Prazo, Outro...)",
      "type": "system",
      "x": 500,
      "y": 1220
    },
    {
      "id": "f1_resp_24h",
      "label": "Cliente respondeu?",
      "type": "condition",
      "x": 500,
      "y": 1420
    },
    {
      "id": "f1_ia_24h",
      "label": "🤖 ENCAMINHA PARA IA\n(IA assume a conversa -> Ver bloco à direita)",
      "type": "message",
      "x": 900,
      "y": 1420
    },
    {
      "id": "f1_end",
      "label": "TRATAMENTO COMERCIAL\n\nRespostas da pesquisa ficam disponíveis para análise da equipe comercial. Encerramento automático.",
      "type": "info",
      "x": 500,
      "y": 1600
    },
    {
      "id": "f1_ia_start",
      "label": "🤖 IA CONVERSACIONAL ASSUME\nIdentifica a intenção da resposta",
      "type": "message",
      "x": 2300,
      "y": 300
    },
    {
      "id": "f1_int_a",
      "label": "INTENÇÃO: QUER COMPRAR\nEx: 'Quero sim', 'Pode fazer'",
      "type": "process",
      "x": 1300,
      "y": 500
    },
    {
      "id": "f1_ia_a",
      "label": "POSTURA DA IA:\nReconhece a intenção de compra, conduz a conversa e orienta sobre o próximo passo. Acolhe o cliente.",
      "type": "message",
      "x": 1300,
      "y": 680
    },
    {
      "id": "f1_sum_a",
      "label": "RESUMO DA TRATATIVA\n• Cliente demonstrou intenção de compra.\n• IA confirmou interesse e conduziu a conversa até o próximo passo.\n• Atendente deve assumir para concluir a operação.",
      "type": "summary",
      "x": 1300,
      "y": 920
    },
    {
      "id": "f1_hum_a",
      "label": "👤 ATENDENTE HUMANO\nAssume para processar o fechamento sistêmico e registrar a venda no CRM.",
      "type": "action",
      "x": 1300,
      "y": 1180
    },
    {
      "id": "f1_int_b",
      "label": "INTENÇÃO: OBJEÇÃO DE PREÇO\nEx: 'Tem desconto?', 'Caro'",
      "type": "process",
      "x": 1700,
      "y": 500
    },
    {
      "id": "f1_ia_b",
      "label": "POSTURA DA IA:\nAdota postura consultiva, entende a objeção e explica os diferenciais disponíveis. Não promete desconto.",
      "type": "message",
      "x": 1700,
      "y": 680
    },
    {
      "id": "f1_sum_b",
      "label": "RESUMO DA TRATATIVA\n• Cliente apresentou objeção de preço.\n• IA explicou diferenciais sem autorizar desconto.\n• Atendente deve assumir para avaliar condição comercial.",
      "type": "summary",
      "x": 1700,
      "y": 920
    },
    {
      "id": "f1_hum_b",
      "label": "👤 ATENDENTE HUMANO\nAssume a negociação para avaliar se aplica condição especial ou desconto.",
      "type": "action",
      "x": 1700,
      "y": 1180
    },
    {
      "id": "f1_int_c",
      "label": "INTENÇÃO: COMPRAR DEPOIS\nEx: 'Vou pensar', 'Mês que vem'",
      "type": "process",
      "x": 2100,
      "y": 500
    },
    {
      "id": "f1_ia_c",
      "label": "POSTURA DA IA:\nRespeita o momento, não pressiona e entende o contexto de retorno de forma amigável.",
      "type": "message",
      "x": 2100,
      "y": 680
    },
    {
      "id": "f1_sum_c",
      "label": "RESUMO DA TRATATIVA\n• Cliente informou que pretende comprar posteriormente.\n• IA conversou sobre o momento do cliente sem pressionar.\n• Atendente assume para definir continuidade.",
      "type": "summary",
      "x": 2100,
      "y": 920
    },
    {
      "id": "f1_hum_c",
      "label": "👤 ATENDENTE HUMANO\nAssume para definir a melhor continuidade comercial e programar follow-ups sistêmicos.",
      "type": "action",
      "x": 2100,
      "y": 1180
    },
    {
      "id": "f1_int_d",
      "label": "INTENÇÃO: OUTRO LUGAR\nEx: 'Já fiz em outra farmácia'",
      "type": "process",
      "x": 2500,
      "y": 500
    },
    {
      "id": "f1_ia_d",
      "label": "POSTURA DA IA:\nEntende o cenário, encerra cordialmente e, quando houver abertura, busca compreender o motivo.",
      "type": "message",
      "x": 2500,
      "y": 680
    },
    {
      "id": "f1_sum_d",
      "label": "RESUMO DA TRATATIVA\n• Cliente informou compra em outro estabelecimento.\n• Principal motivo levantado no contexto da conversa.\n• Atendente recebe o contexto para eventual tratativa.",
      "type": "summary",
      "x": 2500,
      "y": 920
    },
    {
      "id": "f1_hum_d",
      "label": "👤 ATENDENTE HUMANO\nAnalisa o contexto e realiza o processo de classificação/motivo de perda de maneira sistêmica.",
      "type": "action",
      "x": 2500,
      "y": 1180
    },
    {
      "id": "f1_int_e",
      "label": "INTENÇÃO: DESISTÊNCIA\nEx: 'Não tenho mais interesse'",
      "type": "process",
      "x": 2900,
      "y": 500
    },
    {
      "id": "f1_ia_e",
      "label": "POSTURA DA IA:\nRespeita a decisão prontamente, não insiste e encerra a conversa de maneira muito gentil.",
      "type": "message",
      "x": 2900,
      "y": 680
    },
    {
      "id": "f1_sum_e",
      "label": "RESUMO DA TRATATIVA\n• Cliente solicitou o cancelamento/desistência do orçamento.\n• IA encerrou o contato cordialmente sem forçar a venda.\n• Atendimento transferido para encerramento.",
      "type": "summary",
      "x": 2900,
      "y": 920
    },
    {
      "id": "f1_hum_e",
      "label": "👤 ATENDENTE / FINALIZAÇÃO HUMANA\nFinaliza a rotina comercialmente para limpeza da esteira.",
      "type": "action",
      "x": 2900,
      "y": 1180
    },
    {
      "id": "f1_int_f",
      "label": "INTENÇÃO: DÚVIDAS\nEx: 'Como funciona?', 'Entrega?'",
      "type": "process",
      "x": 3300,
      "y": 500
    },
    {
      "id": "f1_ia_f",
      "label": "POSTURA DA IA:\nResponde utilizando EXCLUSIVAMENTE a base de conhecimento. Ao perceber que precisa de intervenção, passa a vez.",
      "type": "message",
      "x": 3300,
      "y": 680
    },
    {
      "id": "f1_sum_f",
      "label": "RESUMO DA TRATATIVA\n• Cliente apresentou dúvida técnica ou operacional.\n• Informações já fornecidas e escopo esgotado da IA.\n• Atendente recebe para prosseguir com o suporte.",
      "type": "summary",
      "x": 3300,
      "y": 920
    },
    {
      "id": "f1_hum_f",
      "label": "👤 ATENDENTE HUMANO\nAssume para esclarecer dúvidas específicas e complexas.",
      "type": "action",
      "x": 3300,
      "y": 1180
    },
